# HW8 image for the Kafka report worker and the FastAPI wrapper (same code, different command).
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "confluent-kafka==2.6.1" "fastapi==0.115.6" "uvicorn[standard]==0.34.0" "pydantic==2.10.4"
COPY src/__init__.py src/kafka_common.py src/kafka_rpc.py src/report_service.py ./src/
COPY backend/__init__.py backend/report_kafka_api.py ./backend/
COPY report_worker.py ./
ENV PYTHONUNBUFFERED=1 HW8_LOG_DIR=/app/logs
