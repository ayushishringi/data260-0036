# Copy to .env and fill in. Never commit .env. Every value below is optional:
# the code falls back to the local-dev default shown here when a variable is unset.

# --- Databases and services (local Docker defaults) ---
DATABASE_URL=            # MySQL SQLAlchemy URL; see backend/database.py for the default
MONGO_URI=mongodb://127.0.0.1:27017
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_BOOTSTRAP=localhost:9092

# --- Local model (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# --- HW7 auth: set real values for anything beyond localhost ---
HW7_JWT_SECRET=          # e.g. python -c "import secrets; print(secrets.token_hex(32))"
HW7_READER_PASSWORD=
HW7_WRITER_PASSWORD=
HW7_MODERATOR_PASSWORD=
